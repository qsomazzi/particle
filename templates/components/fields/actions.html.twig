{% if display == constant('Qsomazzi\\Particle\\Metadata\\Index::TYPE') %}
    {% set readName = admin.getOperationName(constant('Qsomazzi\\Particle\\Metadata\\Read::TYPE')) %}
    {% set updateName = admin.getOperationName(constant('Qsomazzi\\Particle\\Metadata\\Update::TYPE')) %}

    <td>
        {% if readName is not null or updateName is not null %}
            <div class="dropdown">
                <button class="btn dropdown-toggle align-text-top" data-bs-toggle="dropdown" aria-expanded="false">
                    Actions
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    {% if readName is not null %}
                        <a class="dropdown-item" data-turbo-frame="_top" href="{{ path(readName, {(admin.metadata.identifier): value}) }}">Show</a>
                    {% endif %}
                    {% if updateName is not null %}
                        <a class="dropdown-item" data-turbo-frame="_top" href="{{ path(updateName, {(admin.metadata.identifier): value}) }}">Edit</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </td>
{% else %}
    {# Actions are already displayed in the action bar, no need to display them here in show mode #}
{% endif %}
