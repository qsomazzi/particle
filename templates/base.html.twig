<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
        <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
        <title>{% block title %}{{ projectName }}{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}
        {% block javascripts %}
        {% endblock %}
    </head>
    <body class="{% block bodyClass %}layout-fluid{% endblock %}">
        {% block body %}
            <div class="page">
                <div class="sticky-top">
                    <header class="navbar navbar-expand-md d-print-none sticky-top" >
                        <div class="container-xl">
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
                                {% block brandName %}
                                    <a href="{{ path(homepage) }}">
                                        <img src="{{ asset(favicon) }}" width="110" height="32" alt="{{ projectName }}" class="navbar-brand-image" />
                                    </a>
                                {% endblock %}
                            </h1>
                            <div class="navbar-nav flex-row order-md-last">
                                <div class="nav-item d-none d-md-flex me-3">
                                    {% for link in headerLinks %}
                                        <twig:button href="{{ link.url }}" target="{{ link.target }}">
                                            {% if link.icon is not null %}<i class="icon {{ link.icon }}"></i>{% endif %}
                                            {{ link.label }}
                                        </twig:button>
                                    {% endfor %}
                                </div>
                                <twig:notifications />
                                {% block navBarUser %}
                                    <div class="nav-item dropdown">
                                        <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                                            <span class="avatar avatar-sm" style="background-image: url('{{ app.user.avatar }}')"></span>
                                            <div class="d-none d-xl-block ps-2">
                                                <div>{{ app.user }}</div>
                                                <div class="mt-1 small text-secondary">{{ app.user.displayName }}</div>
                                            </div>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                            <a href="{{ path(logout) }}" class="dropdown-item">Logout</a>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </header>
                    <header class="navbar-expand-md">
                        <div class="collapse navbar-collapse" id="navbar-menu">
                            <div class="navbar">
                                <div class="container-xl">
                                    <div class="row flex-fill align-items-center">
                                        <div class="col">
                                            {% block menu %}{{ knp_menu_render('particle', {'currentClass': 'active', 'ancestorClass': 'active'}) }}{% endblock %}
                                        </div>
                                        <div class="col-2 d-none d-xxl-block">
                                            <div class="my-2 my-md-0 flex-grow-1 flex-md-grow-0 order-first order-md-last">
                                                {% if search %}<twig:search />{% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </header>
                </div>

                <div class="page-wrapper">
                    <div class="page-header d-print-none">
                        <div class="container-xl">
                            {% include '@Particle/_flashes.html.twig' %}

                            <div class="row g-2 align-items-center">
                                <div class="col">
                                    <div class="page-pretitle">{% block headerPretitle %}PreTitle{% endblock %}</div>
                                    <h2 class="page-title">{% block headerTitle %}Title{% endblock %}</h2>
                                </div>
                                <div class="col-auto ms-auto d-print-none">
                                    <div class="btn-list">
                                        {% block headerActions %}{% endblock %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="page-body">
                        <div class="container-xl">
                            {% block content %}{% endblock %}
                        </div>
                    </div>
                    <footer class="footer footer-transparent d-print-none">
                        <div class="container-xl">
                            <div class="row text-center align-items-center flex-row-reverse">
                                <div class="col-lg-auto ms-lg-auto">
                                    <ul class="list-inline list-inline-dots mb-0">
                                        {% for link in footerLinks %}
                                            <li class="list-inline-item">
                                                <a href="{{ link.url }}" target="{{ link.target }}" class="link-secondary" rel="noopener">{{ link.label }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                                    <ul class="list-inline list-inline-dots mb-0">
                                        {% block footerCopyright %}
                                            <li class="list-inline-item">
                                                Copyright &copy; {{ 'now'|date('Y') }}
                                                <a href="." class="link-secondary">{{ projectName }}</a>.
                                                All rights reserved.
                                            </li>
                                        {% endblock %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        {% endblock %}
    </body>
</html>
