{% extends 'base.html.twig' %}

{% block headerPretitle %}{% if admin.domain is not null%}{{ admin.domain }}{% endif %}{% endblock %}
{% block headerTitle %}{{ admin.singularLabel }}{% endblock %}

{% block headerActions %}
    <twig:button href="{{ path('admin_' ~ identifier) }}">
        <i class="ti ti-arrow-left"></i>
        Back to list
    </twig:button>
    <twig:button href="{{ path('admin_' ~ identifier ~ '_edit', {'id': entity.id}) }}">
        <i class="ti ti-edit"></i>
        Edit
    </twig:button>

    {{ include('@Particle/Action/_delete_form.html.twig') }}
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ admin.singularLabel }} #{{ entity.id }}</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                {% set display = constant('Qsomazzi\\Particle\\Admin\\AdminInterface::ACTION_SHOW') %}
                {% for field in admin.getFields(display) %}
                    {{
                        component(
                            constant('TYPE', field),
                            {
                                value:      entity.(field.key),
                                label:      field.label,
                                identifier: identifier,
                                display:    display
                            }
                        )
                    }}
                {% endfor %}
            </dl>
        </div>
    </div>
{% endblock %}
