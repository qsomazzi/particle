{% extends 'base.html.twig' %}

{% block headerPretitle %}{{ admin.metadata.domain }}{% endblock %}
{% block headerTitle %}New {{ admin.metadata.singularLabel }}{% endblock %}

{% block headerActions %}
    {% set indexName = admin.getOperationName(constant('Qsomazzi\\Particle\\Metadata\\Index::TYPE')) %}
    {% if indexName is not null %}
        <twig:button href="{{ path(indexName) }}">
            <i class="ti ti-arrow-left"></i>
            Back to list
        </twig:button>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="row row-deck row-cards">
        <div class="col-12">
            {{ include('@Particle/Action/_form.html.twig') }}
        </div>
    </div>
{% endblock %}
