{% extends 'base.html.twig' %}

{% block headerPretitle %}{{ admin.metadata.domain }}{% endblock %}
{% block headerTitle %}{{ admin.metadata.singularLabel }}{% endblock %}

{% block headerActions %}
    {% set indexOperation = admin.getOperationByType(constant('Qsomazzi\\Particle\\Metadata\\Index::TYPE')) %}
    {% if indexOperation is not null %}
        <twig:button href="{{ path(indexOperation.name) }}">
            <i class="icon {{ indexOperation.icon }}"></i>
            {{ indexOperation.text }}
        </twig:button>
    {% endif %}

    {% set readOperation = admin.getOperationByType(constant('Qsomazzi\\Particle\\Metadata\\Read::TYPE')) %}
    {% if readOperation is not null %}
        <twig:button href="{{ path(readOperation.name, {(admin.metadata.identifier): entity.(admin.metadata.identifier)}) }}">
            <i class="icon {{ readOperation.icon }}"></i>
            {{ readOperation.text }}
        </twig:button>
    {% endif %}

    {{ include('@Particle/Action/_delete_form.html.twig') }}
{% endblock %}

{% block content %}
    <div class="row row-deck row-cards">
        <div class="col-12">
            {{ include('@Particle/Action/_form.html.twig', {'button_label': 'Update'}) }}
        </div>
    </div>
{% endblock %}
