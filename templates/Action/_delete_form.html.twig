{% set deleteName = admin.getOperationName(constant('Qsomazzi\\Particle\\Metadata\\Delete::TYPE')) %}
{% if deleteName is not null %}
    {# We can't generate the Delete route, cause expected method is POST only. Since show url is the same, we use this one #}
    <form method="post" action="{{ path(admin.getOperationName(constant('Qsomazzi\\Particle\\Metadata\\Read::TYPE')), {(admin.metadata.identifier): entity.(admin.metadata.identifier)}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.(admin.metadata.identifier)) }}">
        <button class="btn btn-outline-danger">Delete</button>
    </form>
{% endif %}
