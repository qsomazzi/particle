<a class="btn btn-sm btn-pill position-relative btn-outline-primary" data-bs-toggle="offcanvas" href="#filters" role="button" aria-controls="filters">
    <i class="ti ti-filter"></i> Filters

    {% if nbFilters > 0 %}
        <span class="badge bg-blue text-blue-fg badge-notification badge-pill">{{ nbFilters }}</span>
    {% endif %}
</a>

<div class="offcanvas offcanvas-end" tabindex="-1" id="filters" aria-labelledby="filtersLabel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="filtersLabel">Filters</h2>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    {{ form_start(form, {
        'method': 'GET',
        'data-turbo-frame': admin.metadata.shortName ~ '-list',
        'action': app.request.uri
    }) }}

    <div class="offcanvas-body">
        {% for name, child in form.children %}
            {% if name != 'submit' and name != 'clear' %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    </div>

    <div class="offcanvas-footer">
        {{ form_widget(form['submit'], {'label': 'Apply filters', 'attr': {'class': 'btn btn-primary w-100', 'data-bs-dismiss': 'offcanvas'}}) }}
        {{ form_widget(form['clear'], {'label': 'Clear', 'attr': {'class': 'ms-auto btn btn-link w-100', 'data-bs-dismiss': 'offcanvas'}}) }}
    </div>

    {{ form_end(form) }}
</div>